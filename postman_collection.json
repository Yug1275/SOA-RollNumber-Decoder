{
  "info": {
    "_postman_id": "pdeu-roll-decoder-2026",
    "name": "PDEU Student Roll Number Decoder",
    "description": "Postman collection for the PDEU Student Roll Number Decoder Flask API.\nBase URL: http://127.0.0.1:5000\n\nStart the Flask server first:\n  cd Student-Roll-Number-Decoder\n  python app.py\n\nThen run these requests individually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Test 1 – Computer Engineering, 2023 batch (23BCP242)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roll_number\": \"23BCP242\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://127.0.0.1:5000/decode",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["decode"]
        },
        "description": "Expected: HTTP 200, branch=Computer Engineering, enrollment_year=2023, semester=7 (on 25-Oct-2026), expected_degree_completion_year=2027"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Branch is Computer Engineering', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.branch).to.eql('Computer Engineering');",
              "});",
              "pm.test('Enrollment year is 2023', function () {",
              "    pm.expect(pm.response.json().enrollment_year).to.eql(2023);",
              "});",
              "pm.test('Expected completion year is 2027', function () {",
              "    pm.expect(pm.response.json().expected_degree_completion_year).to.eql(2027);",
              "});",
              "pm.test('Semester is a number between 1 and 8', function () {",
              "    var s = pm.response.json().semester;",
              "    pm.expect(s).to.be.a('number');",
              "    pm.expect(s).to.be.within(1, 8);",
              "});"
            ]
          }
        }
      ]
    },
